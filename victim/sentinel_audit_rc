# Sourced by the audited shell (interactive via --rcfile, non-interactive via BASH_ENV).
# Logs every simple command with a timestamp: epoch|CMD|session|user|client_ip|parent>bash>tool|command
[ -n "${SENTINEL_SESSION_ID:-}" ] || return 0
__sentinel_dbg() {
  [ -n "${COMP_LINE:-}" ] && return 0
  case "$BASH_COMMAND" in __sentinel*|trap*) return 0;; esac
  local cmd="${BASH_COMMAND//$'\n'/ }"
  printf '%s|CMD|%s|%s|%s|%s>bash>%s|%s\n' "$(date +%s.%N)" "$SENTINEL_SESSION_ID" "$(id -un)" \
    "$SENTINEL_CLIENT_IP" "$SENTINEL_PARENT" "${cmd%% *}" "$cmd" >> /var/log/sentinel_audit.log
}
trap __sentinel_dbg DEBUG
